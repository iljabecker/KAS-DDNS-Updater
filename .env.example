# KAS API Credentials (from ALL-INKL KAS panel)
#
# Single account:
KAS_LOGIN=w0XXXXXX
KAS_PASSWORD=dein-kas-passwort

# Multiple accounts — use numbered variables (KAS_LOGIN_1, KAS_LOGIN_2, ...).
# Beliebig viele Konten moeglich. KAS_LABEL_N ist optional (Anzeigename im UI).
# KAS_LOGIN_1=w0XXXXXX
# KAS_PASSWORD_1=passwort-konto-1
# KAS_LABEL_1=Kunde A
#
# KAS_LOGIN_2=w0YYYYYY
# KAS_PASSWORD_2=passwort-konto-2
# KAS_LABEL_2=Kunde B
